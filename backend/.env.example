# Copy to .env to override defaults. Every value here is optional.
# .env is gitignored — never commit real keys.

# Swap in PostgreSQL by changing this one line.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aura

# Change this outside development — it signs the access tokens.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=720

# ---------------------------------------------------------------- language model
# Only used to reword Care Coordinator replies. Symptom triage, risk levels and
# action buttons are always decided in code, so leaving this unset costs you
# nothing but a slightly plainer tone.
#
# auto = Gemini if its key is set, else OpenAI, else the rules engine.
LLM_PROVIDER=auto

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# CORS_ORIGINS=["http://localhost:3000"]
